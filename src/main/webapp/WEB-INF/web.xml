<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee 
         http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

    <servlet>
        <servlet-name>UserRegisterServlet</servlet-name>
        <servlet-class>com.transportplanner.servlet.UserRegisterServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>UserRegisterServlet</servlet-name>
        <url-pattern>/registerUser</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>UserLoginServlet</servlet-name>
        <servlet-class>com.transportplanner.servlet.UserLoginServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>UserLoginServlet</servlet-name>
        <url-pattern>/loginUser</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AdminRegisterServlet</servlet-name>
        <servlet-class>com.transportplanner.servlet.AdminRegisterServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminRegisterServlet</servlet-name>
        <url-pattern>/registerAdmin</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AdminLoginServlet</servlet-name>
        <servlet-class>com.transportplanner.servlet.AdminLoginServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminLoginServlet</servlet-name>
        <url-pattern>/loginAdmin</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AddRouteServlet</servlet-name>
        <servlet-class>com.transportplanner.servlet.AddRouteServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AddRouteServlet</servlet-name>
        <url-pattern>/addRoute</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ViewRoutesServlet</servlet-name>
        <servlet-class>com.transportplanner.servlet.ViewRoutesServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ViewRoutesServlet</servlet-name>
        <url-pattern>/viewRoutes</url-pattern>
    </servlet-mapping>
<servlet>
    <servlet-name>LoadRoutesServlet</servlet-name>
    <servlet-class>com.transportplanner.servlet.LoadRoutesServlet</servlet-class>
</servlet>

<servlet-mapping>
    <servlet-name>LoadRoutesServlet</servlet-name>
    <url-pattern>/LoadRoutesServlet</url-pattern>
</servlet-mapping>
    
</web-app>